#!/bin/sh
# POSIX entrypoint. Windows resolves this same MCP token to launch.exe.
set -eu
plugin_scripts=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for interpreter in python3 python; do
    if command -v "$interpreter" >/dev/null 2>&1 &&
       "$interpreter" -c 'import sys; sys.exit(sys.version_info < (3, 10))' >/dev/null 2>&1; then
        exec "$interpreter" -X utf8 "$plugin_scripts/run.py" "$@"
    fi
done
printf '%s\n' 'Mogoo Codex Next requires Python 3.10+ on PATH (python3 or python).' >&2
exit 1
